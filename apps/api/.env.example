# Application Configuration
ENVIRONMENT=development
PORT=8000

# Database Environment Routing ("local", "test", or "supabase")
DB_ENV=local

# Local development database URL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/value_intel

# Dedicated Test PostgreSQL Database (Mandatory for integrations/migrations/isolation tests)
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/value_intel_test

# Remote Supabase Development database URL
SUPABASE_DATABASE_URL=postgresql+psycopg://postgres.[username]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Explicit authorization guard for remote database migrations ("true" or "false")
SUPABASE_MIGRATION_AUTHORIZED=false

# Clerk JWT Verification Configuration
# Clerk Issuer URL (the 'iss' claim in your Clerk token, e.g. https://clerk.yourdomain.com or https://noble-mammal-88.clerk.accounts.dev)
CLERK_ISSUER_URL=https://your-clerk-instance-domain

# Clerk JWKS Endpoint URL (Fetched dynamically to verify Clerk RS256 token signatures)
# Normally: https://your-clerk-instance-domain/.well-known/jwks.json
CLERK_JWKS_URL=https://your-clerk-instance-domain/.well-known/jwks.json
